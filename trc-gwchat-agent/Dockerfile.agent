# GWChat Integration Agent -> AgentCore Runtime (HTTP protocol: POST /invocations + GET /ping on :8080).
# AgentCore Runtime requires linux/arm64 images (ASSUMPTION: verify against current AWS docs). Build with: docker buildx build --platform linux/arm64 ...
FROM --platform=linux/arm64 python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements-agent.txt .
RUN pip install -r requirements-agent.txt
COPY pyproject.toml .
COPY src ./src
RUN pip install --no-deps -e .
RUN useradd -m app && chown -R app /app
USER app
EXPOSE 8080
# opentelemetry-instrument => AgentCore Observability (traces/metrics to CloudWatch / X-Ray)
CMD ["opentelemetry-instrument", "python", "-m", "trc_agent.main"]
