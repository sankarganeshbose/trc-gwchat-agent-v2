# ───────────── MCP server (TRC_MCP_*) ─────────────
TRC_MCP_BACKEND=stub                       # stub | http   (flip to http once real GuideWell APIs are wired)
TRC_MCP_ONPREM_BASE_URL=https://trc-api.onprem.guidewell.example      # PLACEHOLDER
TRC_MCP_CA_BUNDLE=/etc/ssl/guidewell/ca.pem
TRC_MCP_TOKEN_URL=https://login.example/oauth2/v2.0/token             # ASSUMPTION: OAuth2 client-credentials to on-prem APIs
TRC_MCP_CLIENT_ID=<injected>
TRC_MCP_CLIENT_SECRET=<injected from Secrets Manager / AgentCore Identity — never commit>
TRC_MCP_SCOPE=api://trc-onprem/.default
TRC_MCP_READ_TIMEOUT_S=5
TRC_MCP_MAX_RETRIES=2
TRC_MCP_REQUIRE_AUTH=true
TRC_MCP_WRITE_TOOLS_ENABLED=false          # transactional tools off until governance sign-off
TRC_MCP_ENDPOINT_OVERRIDES_JSON={}         # e.g. {"GET_MEMBER":"GET /api/v2/trc/members/{memberId}"}
TRC_MCP_LOG_SALT=<injected>                # salt for PHI-safe id hashes in logs

# ───────────── Agent (TRC_AGENT_*) ─────────────
TRC_AGENT_GATEWAY_URL=https://<gateway-id>.gateway.bedrock-agentcore.<region>.amazonaws.com/mcp
TRC_AGENT_GATEWAY_AUTH=propagate           # propagate | client_credentials | none
TRC_AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
TRC_AGENT_REGION=us-east-1
TRC_AGENT_GUARDRAIL_ID=                    # optional Bedrock Guardrail
TRC_AGENT_WRITE_ACTIONS_ENABLED=false
TRC_AGENT_TICKET_SECRET=<injected from Secrets Manager>   # HMAC key for confirmation tickets
TRC_AGENT_TURN_TIMEOUT_S=90
TRC_AGENT_LOG_SALT=<injected>
